<Project>

  <!--
    Copy this file to "Horde.local.props" (git-ignored) and set the path below for your machine.

    HordeBinDir must point at a *built* Horde server output directory - the same directory the plugin
    will eventually be dropped into. It contains HordeServer.Build.dll, HordeServer.Shared.dll,
    EpicGames.Horde.dll and friends.

    For a UE source engine that is typically:
      <UE>\Engine\Source\Programs\Horde\HordeServer\bin\Development\net10.0

    Build it first if the directory does not exist yet:
      dotnet build <UE>\Engine\Source\Programs\Horde\Horde.sln -c Development

    Alternatively set the HORDE_BIN_DIR environment variable and skip this file entirely.
  -->
  <PropertyGroup>
    <HordeBinDir>D:\Workspaces\dotBunny\DETHOL\Engine\Source\Programs\Horde\HordeServer\bin\Development\net10.0</HordeBinDir>
  </PropertyGroup>

  <!--
    Credentials for the smoke tool (tools/DiscordSmoke), which posts one of every notification this plugin
    produces to a real Discord channel. Optional - leave these unset and everything except that tool still
    builds and runs.

      dotnet run --project tools/DiscordSmoke -c Development

    This file is git-ignored, which is the only reason it is a safe place for a bot token. The values are
    baked into the smoke tool's own assembly at build time and into nothing else, so they never reach the
    plugin, the tests, or anything you would deploy. Each can also be supplied as the environment variable
    named beside it, which is what CI would do.

    To find the ids: turn on Discord's Settings > Advanced > Developer Mode, then right-click a server,
    channel or person and choose "Copy ... ID".
  -->
  <PropertyGroup>
    <!-- DISCORD_BOT_TOKEN - from your application's Bot page. Treat it like a password. -->
    <DiscordBotToken></DiscordBotToken>

    <!-- DISCORD_GUILD_ID - the server the bot has been invited to. -->
    <DiscordGuildId></DiscordGuildId>

    <!-- DISCORD_TEST_CHANNEL_ID - where the smoke tool posts. Use a channel you do not mind filling up. -->
    <DiscordTestChannelId></DiscordTestChannelId>

    <!-- DISCORD_TEST_USER_ID - your own Discord user id, so direct messages and mentions can be checked.
         Optional; without it those scenarios are skipped. You must share the server with the bot. -->
    <DiscordTestUserId></DiscordTestUserId>

    <!-- DISCORD_TEST_ROLE_ID - a role for the triage-ping scenario to mention. Optional.
         Point it at a role NOBODY is in. The bot's own integration role is ideal: Discord creates one per guild
         when the bot is invited, and its only member is the bot. Naming a real team role here means pinging that
         team every time the smoke tool runs. -->
    <DiscordTestRoleId></DiscordTestRoleId>

    <!-- DISCORD_DASHBOARD_URL - used to build the links in each message. Any URL will do. -->
    <DiscordDashboardUrl>https://horde.example.com/</DiscordDashboardUrl>
  </PropertyGroup>

</Project>
